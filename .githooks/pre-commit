#!/bin/sh
# Bloqueia o commit se o plugin sair do formato que as ferramentas instalam.
set -e
npm run -s check
if [ ! -f node_modules/typescript/package.json ]; then
    echo "pre-commit: typescript não está instalado; rode npm install para o hook conseguir rodar o typecheck" >&2
    exit 1
fi
npm run -s typecheck || { echo "pre-commit: npm run typecheck falhou; corrija os erros de tipo acima" >&2; exit 1; }
npm test --silent >/dev/null 2>&1 || { echo "pre-commit: npm test falhou; rode npm test para ver o erro" >&2; exit 1; }
if command -v claude >/dev/null 2>&1; then
    claude plugin validate . >/dev/null && claude plugin validate skills >/dev/null || { echo "pre-commit: claude plugin validate falhou" >&2; exit 1; }
fi
if command -v agy >/dev/null 2>&1; then
    agy plugin validate . >/dev/null 2>&1 || { echo "pre-commit: agy plugin validate falhou" >&2; exit 1; }
fi
